+  assert.equal(rows.length, 2);
+  assert.equal(rows.find(row => row.unit === "slice")?.quantity, 2);
+  assert.equal(rows.find(row => row.unit === "piece")?.quantity, 1);
+  const sliced = rows.find(row => row.unit === "slice")!;
